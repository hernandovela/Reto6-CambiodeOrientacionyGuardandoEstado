<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="8dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RETO 06 · ORIENTACIÓN Y ESTADO" android:textSize="10sp" android:letterSpacing="0.08" android:textColor="@color/x_label" android:gravity="center"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tres en raya" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:layout_marginBottom="8dp"/>
 <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textSize="14sp" android:gravity="center" android:textColor="@color/text_primary" android:background="@drawable/score_background"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textSize="21sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_primary" android:accessibilityLiveRegion="polite"/>
 <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="center" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
 <Button android:id="@+id/restart" android:layout_width="match_parent" android:layout_height="48dp" android:text="Nueva partida" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/text_primary" android:background="@drawable/primary_button" android:backgroundTint="@null" android:stateListAnimator="@null"/>
 <Button android:id="@+id/options" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Opciones ⋮" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button" android:backgroundTint="@null" android:stateListAnimator="@null"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Gira la pantalla: tu partida continúa." android:textSize="12sp" android:gravity="center" android:textColor="@color/text_secondary"/>
</LinearLayout>
