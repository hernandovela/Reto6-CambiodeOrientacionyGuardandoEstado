<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
 <ImageView android:id="@+id/result_icon" android:layout_width="48dp" android:layout_height="48dp" android:importantForAccessibility="no"/>
 <TextView android:id="@+id/result_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/text_primary"/>
 <TextView android:id="@+id/result_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" android:gravity="center" android:textColor="@color/text_secondary"/>
</LinearLayout>
