<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RETO 06 · ORIENTACIÓN Y ESTADO" android:textSize="11sp" android:textColor="#147D73" android:gravity="center"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tres en raya" android:textSize="28sp" android:textStyle="bold" android:textColor="#1A302E" android:gravity="center"/>
 <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textSize="15sp" android:gravity="center" android:textColor="#1A302E" android:background="#E5EDE9"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textSize="21sp" android:textStyle="bold" android:gravity="center" android:textColor="#1A302E" android:accessibilityLiveRegion="polite"/>
 <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="center" android:textColor="#647471"/>
 <Button android:id="@+id/restart" android:layout_width="match_parent" android:layout_height="48dp" android:text="Nueva partida" android:textAllCaps="false"/>
 <Button android:id="@+id/options" android:layout_width="match_parent" android:layout_height="48dp" android:text="Opciones ⋮" android:textAllCaps="false"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gira la pantalla: tu partida continúa." android:textSize="12sp" android:gravity="center" android:textColor="#647471"/>
</LinearLayout>